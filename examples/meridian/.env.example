# Explicit keyless option: maplibre. Blank retains the Google map option.
VITE_MAP_PROVIDER=google
# Optional compatible Shortbread TileJSON; blank uses the OSM public v1 service.
VITE_MAPLIBRE_TILEJSON_URL=
# Optional viewing center only; provide all three or leave all blank (world view).
VITE_MAPLIBRE_INITIAL_LAT=
VITE_MAPLIBRE_INITIAL_LNG=
VITE_MAPLIBRE_INITIAL_ZOOM=

# Required only for the Google map. Keep the real value in .env.local.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Cloud-configured Google map style. Development falls back to DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=

# Optional paid route requests; both flags default to false.
VITE_GOOGLE_ROUTES_ENABLED=false
VITE_GOOGLE_TRANSIT_ENABLED=false
