{
  "name": "eternal-pose-trip-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "pretest": "node scripts/assert-project-readable.mjs",
    "pretype-check": "node scripts/assert-project-readable.mjs",
    "prelint": "node scripts/assert-project-readable.mjs",
    "pretest:experience": "node scripts/assert-project-readable.mjs",
    "pretest:a11y": "node scripts/assert-project-readable.mjs",
    "prebuild": "node scripts/assert-project-readable.mjs",
    "test:experience": "vitest run src/app/generated-experience.contract.test.tsx",
    "test:a11y": "vitest run src/app/generated-accessibility.contract.test.tsx",
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner --cache=false",
    "test:watch": "vitest --configLoader runner --cache=false",
    "test:google-loader": "node --test tests/google-loader-browser.mjs",
    "test:maplibre": "node --test tests/maplibre-browser.mjs",
    "test:maplibre:e2e": "playwright test --config playwright.maplibre.config.ts",
    "test:e2e": "npm run test:google-loader && npm run test:maplibre && npm run test:maplibre:e2e && playwright test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm test && npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "6.10.0",
    "@googlemaps/js-api-loader": "2.1.3",
    "@js-temporal/polyfill": "0.5.1",
    "@laugh-tale-island/adapters": "2.0.0",
    "@laugh-tale-island/core": "2.0.0",
    "@laugh-tale-island/react": "2.0.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@laugh-tale-island/testing": "2.0.0",
    "axe-core": "4.11.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/google.maps": "3.66.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
