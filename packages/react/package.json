{
  "name": "@laugh-tale-island/react",
  "version": "1.0.0",
  "description": "React hooks and prop-getters for map-first travel sites built on @laugh-tale-island/core.",
  "license": "MIT",
  "author": "XBlueSky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XBlueSky/laugh-tale.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/XBlueSky/laugh-tale#readme",
  "bugs": {
    "url": "https://github.com/XBlueSky/laugh-tale/issues"
  },
  "keywords": [
    "travel",
    "itinerary",
    "trip",
    "headless",
    "react",
    "hooks",
    "map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@laugh-tale-island/core": "1.0.0",
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@laugh-tale-island/core": "1.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
