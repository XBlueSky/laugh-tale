{
  "name": "@laugh-tale-island/core",
  "version": "1.0.0",
  "description": "Framework-neutral trip model, validation, scheduling, progress, routes, and presentation selectors for map-first travel sites.",
  "license": "MIT",
  "author": "XBlueSky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XBlueSky/laugh-tale.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/XBlueSky/laugh-tale#readme",
  "bugs": {
    "url": "https://github.com/XBlueSky/laugh-tale/issues"
  },
  "keywords": [
    "travel",
    "itinerary",
    "trip",
    "headless",
    "scheduling",
    "map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  }
}
