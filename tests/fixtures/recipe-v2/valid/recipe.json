{
  "schemaVersion": 2,
  "id": "valid",
  "label": "Valid Recipe",
  "summary": "A complete internal recipe fixture.",
  "register": "product",
  "presentation": {
    "source": "presentation",
    "entry": "index.ts",
    "css": ["styles/index.css"],
    "assets": ["assets"]
  },
  "map": {
    "profile": "map/profile.json",
    "googleStyleGuide": "docs/google-map-style.json"
  },
  "motion": {
    "durationMs": 240,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "interruptible": true,
    "reducedMotion": "instant"
  },
  "features": ["media", "desktop-windows"],
  "font": {
    "policy": "system",
    "assets": []
  },
  "validation": {
    "viewports": [320, 390, 430, 768, 1024, 1440],
    "screenshots": ["home", "experience", "experience-expanded"]
  }
}
