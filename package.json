{
  "name": "laugh-tale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build:packages": "npm run build --workspaces",
    "test:packages": "npm run test --workspaces",
    "lint:packages": "npm run lint --workspaces",
    "type-check:packages": "npm run type-check --workspaces",
    "validate:plugins": "node scripts/validate-plugin-contracts.mjs",
    "check:marketplace": "cc-marketspec --check",
    "build:marketplace": "cc-marketspec",
    "check": "npm run validate:plugins && npm run check:marketplace && npm run build:packages && npm test && npm run test:packages && npm run type-check && npm run type-check:packages && npm run lint && npm run lint:packages",
    "stage:starter": "node scripts/stage-starter-consumer.mjs",
    "test:starter:staged": "npm --prefix tmp/staged-starter run check",
    "test:e2e:staged": "npm --prefix tmp/staged-starter run test:e2e",
    "test:starter": "npm --prefix plugins/eternal-pose/starter/react run check",
    "test:e2e": "npm --prefix plugins/eternal-pose/starter/react run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@xbluesky/cc-marketspec": "1.0.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
