{
  "name": "laugh-tale",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:generator:v2": "vitest run tests/generation/project-manifest-v2.test.ts tests/generation/portable-enrichment-contract.test.ts tests/generation/recipe-v2.test.ts tests/generation/create-real-starter.test.ts tests/generation/generated-project.test.ts tests/scripts/atomic-publication.test.ts tests/scripts/create-trip-project.test.ts tests/scripts/enrich-trip-project.test.ts tests/scripts/verify-trip-project.test.ts tests/scripts/upgrade-trip-project.test.ts tests/scripts/sync-oak-washi-starter-presentation.test.ts tests/scripts/stage-starter-consumer.test.ts tests/scripts/stage-starter-consumer-concurrency.test.ts tests/scripts/write-registry-lockfile.test.ts tests/scripts/replace-generated-project.test.ts tests/scripts/project-reader-boundaries.test.ts; root_status=$?; npm --prefix plugins/eternal-pose/starter/react exec -- vitest run --root plugins/eternal-pose/starter/react --configLoader runner --cache=false src/trip-content/materialize-trip.test.ts; starter_status=$?; test $root_status -eq 0 && test $starter_status -eq 0",
    "test:example:identity": "vitest run tests/examples",
    "test:oak-washi:unit": "vitest run --project unit oak-washi",
    "test:oak-washi:browser": "playwright test --config=packages/testing/playwright.config.ts",
    "test:oak-washi:update-goldens": "playwright test --config=packages/testing/playwright.config.ts tests/visual/oak-washi.visual.spec.ts --update-snapshots",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build:packages": "npm run build --workspaces",
    "test:packages": "npm run test --workspaces",
    "lint:packages": "npm run lint --workspaces",
    "type-check:packages": "npm run type-check --workspaces",
    "validate:plugins": "node scripts/validate-plugin-contracts.mjs",
    "check:marketplace": "cc-marketspec --check",
    "build:marketplace": "cc-marketspec",
    "check": "npm run validate:plugins && npm run check:marketplace && npm run build:packages && npm test && npm run test:packages && npm run type-check && npm run type-check:packages && npm run lint && npm run lint:packages",
    "stage:starter": "node scripts/stage-starter-consumer.mjs",
    "test:starter:staged": "npm --prefix \"${LAUGH_TALE_STARTER_ROOT:-tmp/staged-starter}\" run check",
    "test:e2e:staged": "npm --prefix \"${LAUGH_TALE_STARTER_ROOT:-tmp/staged-starter}\" run test:e2e",
    "test:starter": "node scripts/test-starter-consumer.mjs",
    "test:e2e": "npm --prefix plugins/eternal-pose/starter/react run test:e2e",
    "test:example:offline": "vitest run tests/scripts/replace-generated-project.test.ts tests/examples",
    "stage:example": "node scripts/stage-starter-consumer.mjs --out \"$PWD/tmp/staged-meridian\" --trip \"$PWD/examples/meridian-input/trip-input.json\"",
    "test:example:staged": "npm --prefix tmp/staged-meridian run check",
    "test:example:e2e": "npm --prefix tmp/staged-meridian run test:e2e"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.62.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xbluesky/cc-marketspec": "1.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.13.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
