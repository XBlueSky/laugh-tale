{
  "name": "eternal-pose-trip-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner --cache=false",
    "test:watch": "vitest --configLoader runner --cache=false",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm test && npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@js-temporal/polyfill": "0.5.1",
    "@laugh-tale-island/core": "1.0.0",
    "@laugh-tale-island/react": "1.0.0",
    "lucide-react": "1.52.0",
    "motion": "13.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/google.maps": "3.66.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
